{
	"schemaVersion": 1,
	"id": "empyrium-mod",
	"version": "${version}",
	"name": "Empyrium Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/empyrium-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "quest.nekoniyah.empyriummod.EmpyriumMod",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "quest.nekoniyah.empyriummod.client.EmpyriumModClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "quest.nekoniyah.empyriummod.client.EmpyriumModDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"empyrium-mod.mixins.json",
		{
			"config": "empyrium-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}